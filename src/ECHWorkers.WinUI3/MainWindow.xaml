<root:Window
    x:Class="ECHWorkers.WinUI3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:root="using:Microsoft.UI.Xaml"
    Title="ECH Workers Client">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="Transparent" Padding="16,0,138,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="6" Background="{ThemeResource AccentFillColorDefaultBrush}" Margin="0,0,10,0">
                    <TextBlock Text="E" FontSize="12" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="ECH Workers" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Padding="16,12,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="12" Margin="0,0,16,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="8" Padding="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse Width="7" Height="7" Fill="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="概览" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse Width="7" Height="7" Fill="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="服务器" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse Width="7" Height="7" Fill="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="代理" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse Width="7" Height="7" Fill="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="日志" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,16,0">
                            <TextBlock Text="节点" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="example.com:443" FontWeight="SemiBold" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <Border CornerRadius="999" Padding="10,6" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#22C55E" Margin="0,0,8,0"/>
                                    <TextBlock Text="就绪" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="999" Padding="10,6" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <TextBlock Text="监听 127.0.0.1:30000" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </Border>
                            <Border CornerRadius="999" Padding="10,6" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <TextBlock Text="分流 bypass_cn" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="启动代理" Padding="16,10" FontSize="14"/>
                            <Button Content="设置系统代理" Padding="16,10" FontSize="14"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="快捷操作" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="编辑服务器" Padding="12,10" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="查看日志" Padding="12,10" Margin="4,0,4,0"/>
                            <Button Grid.Column="2" Content="重新加载配置" Padding="12,10" Margin="8,0,0,0"/>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="运行日志" FontWeight="SemiBold" Margin="0,0,0,12" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                        <Border Grid.Row="1" Background="{ThemeResource ControlFillColorTertiaryBrush}" CornerRadius="10" Padding="12">
                            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="LogText" Text="等待启动代理..." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</root:Window>
