<root:Window
    x:Class="ECHWorkers.WinUI3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:root="using:Microsoft.UI.Xaml"
    xmlns:pages="using:ECHWorkers.WinUI3.Pages"
    Title="ECH Workers">
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧固定侧边栏（永不收起） -->
        <Grid Grid.Column="0" x:Name="SidebarHost">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 导航项 -->
            <controls:Button Grid.Row="1" x:Name="NavHome" Tag="home"
                    Style="{StaticResource SidebarItemButton}" Click="NavItem_Click"
                    PointerEntered="NavItem_PointerEntered" PointerExited="NavItem_PointerExited">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <controls:FontIcon Grid.Column="0" Glyph="&#xE80F;" FontSize="16"
                              HorizontalAlignment="Left"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Grid.Column="1" Text="首页" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </Grid>
            </controls:Button>

            <controls:Button Grid.Row="2" x:Name="NavServers" Tag="servers"
                    Style="{StaticResource SidebarItemButton}" Click="NavItem_Click"
                    PointerEntered="NavItem_PointerEntered" PointerExited="NavItem_PointerExited">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <controls:FontIcon Grid.Column="0" Glyph="&#xE713;" FontSize="15"
                              HorizontalAlignment="Left"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Grid.Column="1" Text="服务器" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </Grid>
            </controls:Button>

            <!-- 底部关于 -->
            <controls:Button Grid.Row="3" x:Name="NavAbout" Tag="about"
                    Style="{StaticResource SidebarItemButton}" Click="NavItem_Click"
                    PointerEntered="NavItem_PointerEntered" PointerExited="NavItem_PointerExited"
                    VerticalAlignment="Bottom" Margin="8,2,8,20">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <controls:FontIcon Grid.Column="0" Glyph="&#xE946;" FontSize="15"
                              HorizontalAlignment="Left"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Grid.Column="1" Text="关于" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </Grid>
            </controls:Button>
        </Grid>

        <!-- 右侧内容区：内容铺满，标题栏拖拽条叠加在顶部 -->
        <Grid Grid.Column="1">
            <Grid x:Name="PageHost"/>
            <Border x:Name="TitleBarStrip" Height="48"
                    VerticalAlignment="Top" Background="Transparent"/>
        </Grid>

        <!-- 标题栏应用名称（覆盖在侧边栏顶部标题栏区域） -->
        <Border Grid.Column="0" Margin="20,0,0,0" VerticalAlignment="Top" Height="48">
            <TextBlock Text="ECH Workers" FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
        </Border>
    </Grid>
</root:Window>
