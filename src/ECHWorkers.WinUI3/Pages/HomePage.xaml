<UserControl
    x:Class="ECHWorkers.WinUI3.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ECHWorkers.WinUI3.Models"
    xmlns:cv="using:ECHWorkers.WinUI3.Converters">
    <UserControl.Resources>
        <!-- 复用全局转换器实例（App.xaml 中注册） -->
        <cv:BoolConverter x:Key="Invert"/>
        <cv:BoolConverter x:Key="Dim"/>
    </UserControl.Resources>
    <Grid Padding="28,52,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 节点基本信息 -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 服务器选择 -->
                <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="4" Margin="0,0,20,0">
                    <TextBlock Text="服务器配置" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ComboBox x:Name="ServerCombo" Width="170" Padding="10,7" FontSize="13"
                              VerticalContentAlignment="Center"
                              IsEnabled="{Binding IsRunning, Converter={StaticResource Invert}, ConverterParameter=invert}"
                              SelectionChanged="ServerCombo_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- 节点信息 -->
                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="{Binding NodeServer}" FontSize="19"
                               FontWeight="SemiBold" MaxWidth="260" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="{Binding NodeName}" FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,2,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7"
                                     Fill="{Binding StatusDotFill}"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ListenText}" FontSize="12"
                                   FontFamily="Consolas"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- 分流 + 启动 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center" HorizontalAlignment="Right">
                    <StackPanel Orientation="Vertical" Spacing="4">
                        <TextBlock Text="分流模式" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <ComboBox x:Name="RoutingCombo" Width="120" Padding="8,7" FontSize="13"
                                  VerticalContentAlignment="Center" SelectedIndex="0"
                                  IsEnabled="{Binding IsRunning, Converter={StaticResource Invert}, ConverterParameter=invert}">
                            <ComboBoxItem Content="全局代理" Tag="global"/>
                            <ComboBoxItem Content="跳过大陆" Tag="bypass_cn"/>
                            <ComboBoxItem Content="不改变" Tag="none"/>
                        </ComboBox>
                    </StackPanel>
                    <Button x:Name="StartButton" Style="{StaticResource PrimaryActionButton}"
                            Click="StartButton_Click" VerticalAlignment="Bottom"
                            IsEnabled="{Binding CanStart}"
                            PointerEntered="PrimaryBtn_PointerEntered" PointerExited="PrimaryBtn_PointerExited">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <FontIcon Glyph="{Binding StartGlyph}" FontSize="13"
                                      FontFamily="Segoe Fluent Icons"/>
                            <TextBlock Text="{Binding StartText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 运行日志 -->
        <Border Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource CardBorder}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="运行日志" Style="{StaticResource CardHeaderTitle}"/>
                    <TextBlock HorizontalAlignment="Right" Text="点击启动后实时写入" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>

                <!-- 虚拟化日志列表：只实例化可见区域，配合有界集合与批量刷新，
                     渲染成本与日志总量、产生速率解耦 -->
                <Border Grid.Row="1" CornerRadius="10" Padding="12"
                        Background="{ThemeResource ControlFillColorTertiaryBrush}">
                    <ListView x:Name="LogList" Loaded="LogList_Loaded"
                              SelectionMode="None" IsSwipeEnabled="False"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <!-- 关闭条目过渡动画：高频追加时动画本身开销显著 -->
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection/>
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Padding" Value="0,1"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="IsTabStop" Value="False"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:LogEntry">
                                <TextBlock Text="{x:Bind Display}"
                                           Foreground="{x:Bind Brush}"
                                           TextWrapping="Wrap" FontSize="12"
                                           FontFamily="Consolas"
                                           IsTextScaleFactorEnabled="False"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
