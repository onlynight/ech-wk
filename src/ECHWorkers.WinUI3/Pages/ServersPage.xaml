<UserControl
    x:Class="ECHWorkers.WinUI3.Pages.ServersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <UserControl.Resources>
        <!-- 单个服务器列表项 -->
        <DataTemplate x:Key="ServerItemTemplate">
            <Grid Margin="6,3" Padding="12,10" CornerRadius="10"
                  Background="{ThemeResource ControlFillColorSecondaryBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"
                          IsChecked="{Binding IsSelected, Mode=TwoWay}"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="{Binding Server}" FontSize="12" FontFamily="Consolas"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                        <Border CornerRadius="6" Padding="8,3"
                                Background="{ThemeResource ControlFillColorTertiaryBrush}">
                            <TextBlock Text="{Binding Listen}" FontSize="11" FontFamily="Consolas"/>
                        </Border>
                        <Border CornerRadius="6" Padding="8,3"
                                Background="{ThemeResource ControlFillColorTertiaryBrush}">
                            <TextBlock Text="{Binding Routing}" FontSize="11"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="2" Content="编辑" Style="{StaticResource SecondaryActionButton}"
                        Padding="14,6" Margin="0,0,8,0" FontSize="12.5"
                        Click="EditButton_Click" Tag="{Binding}"/>
                <Button Grid.Column="3" Style="{StaticResource GhostIconButton}"
                        FontFamily="Segoe Fluent Icons" FontSize="14" Content="&#xE74D;"
                        Click="ItemDeleteButton_Click" Tag="{Binding}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Padding="28,52,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <CheckBox x:Name="SelectAllCheckBox" VerticalAlignment="Center"
                          Content="全选" Click="SelectAllCheckBox_Click"/>
                <Button x:Name="DeleteButton" Content="删除" Style="{StaticResource SecondaryActionButton}"
                        Padding="14,7" FontSize="13" IsEnabled="False" Click="DeleteButton_Click"/>
            </StackPanel>
            <Button x:Name="AddButton" HorizontalAlignment="Right"
                    Style="{StaticResource PrimaryActionButton}" Click="AddButton_Click"
                    PointerEntered="PrimaryBtn_PointerEntered" PointerExited="PrimaryBtn_PointerExited">
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE710;" FontSize="13" FontFamily="Segoe Fluent Icons"/>
                    <TextBlock Text="新增服务器" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 列表 -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="8">
            <Grid>
                <controls:ItemsRepeater x:Name="ServerList"
                                        ItemTemplate="{StaticResource ServerItemTemplate}"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <controls:ItemsRepeater.Layout>
                        <controls:StackLayout />
                    </controls:ItemsRepeater.Layout>
                </controls:ItemsRepeater>

                <StackPanel x:Name="EmptyHint" Spacing="10"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <FontIcon Glyph="&#xE713;" FontSize="32" FontFamily="Segoe Fluent Icons"
                              HorizontalAlignment="Center" Opacity="0.35"/>
                    <TextBlock Text="暂无服务器配置" FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="点击右上角「新增服务器」添加" FontSize="12.5"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
