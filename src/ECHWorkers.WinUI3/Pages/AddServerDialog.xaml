<root:Window
    x:Class="ECHWorkers.WinUI3.Pages.AddServerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:root="using:Microsoft.UI.Xaml"
    Title="新增服务器">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏拖拽区 -->
        <Grid Grid.Row="0" x:Name="TitleBarStrip" Background="Transparent">
            <TextBlock x:Name="DialogTitle" Text="新增服务器" FontSize="15" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="24,0,0,0"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="24,8,24,16" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="22" HorizontalAlignment="Stretch">

                <!-- 服务器名称 -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="服务器名称" Style="{StaticResource FieldLabel}" Margin="0"/>
                        <TextBox x:Name="NameBox" Style="{StaticResource FormTextBox}"
                                 FontSize="18" FontWeight="SemiBold"
                                 TextWrapping="NoWrap" AcceptsReturn="False"/>
                    </StackPanel>
                </Border>

                <!-- 核心配置 -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE713;" FontSize="14" FontFamily="Segoe Fluent Icons"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="核心配置" Style="{StaticResource CardHeaderTitle}"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="服务器地址"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ServerBox" Grid.Row="1" Grid.Column="0"
                                     Style="{StaticResource FormTextBox}" Margin="0,0,0,16"
                                     Header="host:port（如 example.com:443）"
                                     TextWrapping="NoWrap" AcceptsReturn="False"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="本地监听地址"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ListenBox" Grid.Row="1" Grid.Column="2"
                                     Style="{StaticResource FormTextBox}" Margin="0,0,0,16"
                                     Header="如 127.0.0.1:30000"
                                     TextWrapping="NoWrap" AcceptsReturn="False"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Token"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TokenBox" Grid.Row="3" Grid.Column="0"
                                     Style="{StaticResource FormTextBox}" Margin="0,0,0,0"
                                     Header="身份验证令牌（可选）"
                                     TextWrapping="NoWrap" AcceptsReturn="False"/>

                            <TextBlock Grid.Row="2" Grid.Column="2" Text="服务 IP"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="IpBox" Grid.Row="3" Grid.Column="2"
                                     Style="{StaticResource FormTextBox}" Margin="0,0,0,0"
                                     Header="指定 IP 绕过 DNS（可选）"
                                     TextWrapping="NoWrap" AcceptsReturn="False"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 高级选项 -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE713;" FontSize="14" FontFamily="Segoe Fluent Icons"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="高级选项" Style="{StaticResource CardHeaderTitle}"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="DNS 服务器"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="DnsBox" Grid.Row="1" Grid.Column="0"
                                     Style="{StaticResource FormTextBox}" Margin="0,0,0,0"
                                     Header="DoH 服务器（默认 dns.alidns.com/dns-query）"
                                     TextWrapping="NoWrap" AcceptsReturn="False"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="ECH 域名"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="EchBox" Grid.Row="1" Grid.Column="2"
                                     Style="{StaticResource FormTextBox}" Margin="0,0,0,0"
                                     Header="ECH 查询域名（默认 cloudflare-ech.com）"
                                     TextWrapping="NoWrap" AcceptsReturn="False"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Padding="24,16" Background="Transparent"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button x:Name="CancelButton" Content="取消" Style="{StaticResource SecondaryActionButton}"
                        Click="CancelButton_Click"/>
                <Button x:Name="SaveButton" Content="保存" Style="{StaticResource PrimaryActionButton}"
                        Click="SaveButton_Click"
                        PointerEntered="PrimaryBtn_PointerEntered" PointerExited="PrimaryBtn_PointerExited"/>
            </StackPanel>
        </Border>
    </Grid>
</root:Window>
