<UserControl
    x:Class="ECHWorkers.WinUI3.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="28,52,28,24">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="0">
            <StackPanel Spacing="18" MaxWidth="620" HorizontalAlignment="Center">

                <!-- 标题 -->
                <StackPanel HorizontalAlignment="Center" Margin="0,8,0,20" Spacing="14">
                    <Border Width="72" Height="72" CornerRadius="18" Background="#1C1C1E">
                        <TextBlock Text="E" FontSize="34" FontWeight="Bold" Foreground="#FAFAFA"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="ECH Workers" FontSize="24" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="Windows 原生客户端 · 基于 ECH 协议的本地代理工具"
                               FontSize="13" HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- 版本信息卡片 -->
                <Border Style="{StaticResource CardBorder}" Padding="0">
                    <StackPanel>
                        <Grid Padding="20,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                                    Margin="0,0,16,0"
                                    Background="{ThemeResource ControlFillColorTertiaryBrush}">
                                <FontIcon Glyph="&#xE754;" FontSize="16" FontFamily="Segoe Fluent Icons"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="客户端版本" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="ClientVersion" Text="v0.1.0" FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text=".NET 8 · WinUI 3" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>

                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>

                        <Grid Padding="20,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                                    Margin="0,0,16,0"
                                    Background="{ThemeResource ControlFillColorTertiaryBrush}">
                                <FontIcon Glyph="&#xE945;" FontSize="16" FontFamily="Segoe Fluent Icons"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="ech-workers 内核版本" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="EchVersion" Text="v1.3" FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="Go 核心" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 构建信息 -->
                <Border Style="{StaticResource CardBorder}" Padding="20,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,32,0">
                            <TextBlock Text="运行环境" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="RuntimeText" Text="Windows 11 · x64" FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="构建日期" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="BuildDateText" Text="2026-10-01" FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 说明 -->
                <TextBlock TextWrapping="Wrap" FontSize="12.5" TextAlignment="Center"
                           HorizontalAlignment="Center" LineHeight="20" Margin="0,8,0,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    客户端通过 Windows 原生 UI 管理节点、代理与系统设置。
                </TextBlock>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
