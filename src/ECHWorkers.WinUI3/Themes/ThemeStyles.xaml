<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <!--
        全局样式（ChatGPT 风格）。
        本 SDK 版本的 XAML 编译器不支持独立字典中的 ControlTemplate.Triggers，
        因此所有状态反馈（悬停、选中）统一由代码后置处理，这里只定义静态外观。
        - CardBorder：统一卡片外观
        - FieldLabel / FormTextBox / CardHeaderTitle：文本与表单
        - SidebarItemButton：侧边导航项（选中态由代码后置设置 Foreground/Opacity）
        - GhostIconButton：无边框圆形图标按钮
        - PrimaryActionButton：深色主操作按钮（不依赖系统强调色）
        - SecondaryActionButton：次级圆角按钮
    -->

    <Style x:Key="CardBorder" TargetType="controls:Border">
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
    </Style>

    <Style x:Key="CardHeaderTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
    </Style>

    <Style x:Key="CardHeaderSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="FormTextBox" TargetType="controls:TextBox">
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- 侧边导航项：静态圆角，选中/悬停由代码后置着色 -->
    <Style x:Key="SidebarItemButton" TargetType="controls:Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="8,2,8,2"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="44"/>
    </Style>

    <!-- 无边框圆形图标按钮 -->
    <Style x:Key="GhostIconButton" TargetType="controls:Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
        <Setter Property="FontSize" Value="15"/>
    </Style>

    <!-- 主操作按钮：深色胶囊，不依赖系统强调色 -->
    <Style x:Key="PrimaryActionButton" TargetType="controls:Button">
        <Setter Property="Background" Value="#1C1C1E"/>
        <Setter Property="Foreground" Value="#FAFAFA"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- 次级按钮：细边框圆角 -->
    <Style x:Key="SecondaryActionButton" TargetType="controls:Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

</ResourceDictionary>
